<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/navy"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍"
                android:textSize="36sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selected Locations"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose where you want to operate for shared rides"
                android:textSize="12sp"
                android:textColor="#DCE6EF"
                android:gravity="center"
                android:layout_marginTop="5dp"/>

        </LinearLayout>

        <!-- Selection Summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="16dp"
            android:layout_marginTop="18dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selection Overview"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/navy"/>

            <TextView
                android:id="@+id/operatingAreasSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading your operating areas..."
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/teal"
                android:background="@color/screen_background"
                android:padding="14dp"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- Operating Areas Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="16dp"
            android:layout_marginTop="18dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose Your Operating Areas"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/navy"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Entire Mauritius for unrestricted coverage, or expand a region to choose specific localities and sublocalities."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"/>

            <LinearLayout
                android:id="@+id/operatingAreasContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp"/>

        </LinearLayout>

        <!-- Selected Locations List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="16dp"
            android:layout_marginTop="18dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Selected Locations"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/navy"/>

            <LinearLayout
                android:id="@+id/selectedOperatingAreasContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/screen_background"
                android:padding="12dp"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- Save Operating Areas -->
        <Button
            android:id="@+id/saveOperatingAreasButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="SAVE SELECTED LOCATIONS"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/teal"
            android:layout_marginTop="22dp"
            android:elevation="3dp"/>

        <!-- Back Button -->
        <Button
            android:id="@+id/backToDriverAccountButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="BACK TO DRIVER ACCOUNT"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/navy"
            android:backgroundTint="@color/screen_background"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>
