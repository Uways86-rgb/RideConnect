<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Account"
                android:textColor="#102C46"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/passengerAccountGreetingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage your personal information"
                android:textColor="#718096"
                android:textSize="14sp"
                android:layout_marginBottom="20dp"/>

            <!-- PERSONAL INFORMATION CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@color/card_white"
                android:elevation="3dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Personal Information"
                    android:textColor="#102C46"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textColor="#718096"
                    android:textSize="13sp"/>

                <EditText
                    android:id="@+id/passengerNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter your full name"
                    android:inputType="textPersonName"
                    android:singleLine="true"
                    android:textColor="#172B3A"
                    android:textSize="15sp"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textColor="#718096"
                    android:textSize="13sp"/>

                <EditText
                    android:id="@+id/passengerEmailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email address"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:enabled="false"
                    android:textColor="#718096"
                    android:textSize="15sp"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phone Number"
                    android:textColor="#718096"
                    android:textSize="13sp"/>

                <EditText
                    android:id="@+id/passengerPhoneInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter your phone number"
                    android:inputType="phone"
                    android:singleLine="true"
                    android:textColor="#172B3A"
                    android:textSize="15sp"
                    android:layout_marginBottom="18dp"/>

                <Button
                    android:id="@+id/savePassengerAccountButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save Changes"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#167D83"/>

            </LinearLayout>

            <!-- ACCOUNT SETTINGS CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@color/card_white"
                android:elevation="3dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Account Settings"
                    android:textColor="#102C46"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"/>

                <Button
                    android:id="@+id/passengerSupportButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Help and Support"
                    android:textColor="#102C46"
                    android:backgroundTint="#EAF2F5"/>

            </LinearLayout>

            <!-- LOGOUT -->

            <Button
                android:id="@+id/passengerLogoutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Log Out"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D64545"
                android:layout_marginBottom="20dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- PASSENGER BOTTOM NAVIGATION -->

    <LinearLayout
        android:id="@+id/passengerAccountBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/card_white"
        android:elevation="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/passengerAccountHomeNavItem"
            android:layout_width="0dp"
            android:layout_height="61dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textColor="#718096"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>

        <TextView
            android:id="@+id/passengerAccountExploreNavItem"
            android:layout_width="0dp"
            android:layout_height="61dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌕\nExplore"
            android:textColor="#718096"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>

        <TextView
            android:id="@+id/passengerAccountBookingsNavItem"
            android:layout_width="0dp"
            android:layout_height="61dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▤\nBookings"
            android:textColor="#718096"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>

        <TextView
            android:id="@+id/passengerAccountNavItem"
            android:layout_width="0dp"
            android:layout_height="61dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="●\nAccount"
            android:textColor="#167D83"
            android:textStyle="bold"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>

    </LinearLayout>

</LinearLayout>
