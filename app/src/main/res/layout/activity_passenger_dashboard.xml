<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background">

    <!-- MAP SECTION -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="215dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:elevation="4dp">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@color/card_white"
            android:padding="9dp"
            android:text="RideConnect Map"
            android:textColor="@color/navy"
            android:textStyle="bold"
            android:elevation="3dp" />

    </FrameLayout>

    <!-- SCROLLABLE DASHBOARD CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- WELCOME -->
            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hello Passenger 👋"
                android:textColor="@color/navy"
                android:textSize="25sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Where would you like to go today?"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:layout_marginBottom="18dp" />

            <!-- LOCATION AND DESTINATION CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_white"
                android:padding="18dp"
                android:elevation="3dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Plan your journey"
                    android:textColor="@color/navy"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="YOUR PICKUP LOCATION"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/currentLocationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📍 Detecting your location..."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <Button
                    android:id="@+id/useCurrentLocationButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="USE CURRENT LOCATION"
                    android:textColor="@color/teal"
                    android:backgroundTint="@color/screen_background"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/pickupInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter pickup location"
                    android:singleLine="true"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:backgroundTint="@color/teal"
                    android:padding="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DESTINATION"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="18dp" />

                <EditText
                    android:id="@+id/destinationInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Where are you going?"
                    android:singleLine="true"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:backgroundTint="@color/teal"
                    android:padding="12dp" />

                <Button
                    android:id="@+id/searchDestinationButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FIND DESTINATION ON MAP"
                    android:textColor="@color/teal"
                    android:backgroundTint="@color/screen_background"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/findRideButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="FIND A RIDE"
                    android:textColor="@color/card_white"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:backgroundTint="@color/teal"
                    android:layout_marginTop="20dp" />

            </LinearLayout>

            <!-- RIDE STATUS CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_white"
                android:padding="18dp"
                android:elevation="3dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your ride"
                    android:textColor="@color/navy"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ready to find a ride"
                    android:textColor="@color/teal"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/driverNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/driverPhoneText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/driverCarText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/rideDetailsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/rideHistoryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="VIEW RIDE HISTORY"
                    android:textColor="@color/teal"
                    android:backgroundTint="@color/screen_background"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- LEGACY BUTTONS: navigation is provided below -->
            <Button
                android:id="@+id/searchRidesButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SEARCH AVAILABLE RIDES"
                android:visibility="gone" />

            <Button
                android:id="@+id/myBookingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MY BOOKINGS"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/passengerBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/card_white"
        android:elevation="8dp"
        android:paddingBottom="12dp"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/homeNavItem"
            android:layout_width="0dp"
            android:layout_height="61dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textColor="@color/teal"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/exploreNavItem"
            android:layout_width="0dp"
            android:layout_height="61dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌕\nExplore"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/bookingsNavItem"
            android:layout_width="0dp"
            android:layout_height="61dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▤\nBookings"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/accountNavItem"
            android:layout_width="0dp"
            android:layout_height="61dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="●\nAccount"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

</LinearLayout>
