<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Brand header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/navy"
            android:padding="28dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:gravity="center"
                android:text="🚗"
                android:textSize="55sp"
                android:background="@color/white"
                android:elevation="5dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RideConnect"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="sans"
                android:layout_marginTop="22dp"
                android:letterSpacing="0.02"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMARTER RIDES. BETTER CONNECTIONS."
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/gold"
                android:letterSpacing="0.12"
                android:gravity="center"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your journey starts here."
                android:textSize="15sp"
                android:textColor="#DCE6EF"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- Role selection section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="32dp"
            android:paddingBottom="28dp"
            android:background="@color/white">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome to RideConnect"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose how you would like to use the app."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="27dp"/>

            <!-- Passenger button -->
            <Button
                android:id="@+id/passengerButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="👤   Continue as Passenger"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:backgroundTint="@color/teal"
                android:elevation="3dp"
                android:letterSpacing="0.01"/>

            <!-- Driver button -->
            <Button
                android:id="@+id/driverButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="🚗   Continue as Driver"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:backgroundTint="@color/navy"
                android:elevation="3dp"
                android:layout_marginTop="15dp"
                android:letterSpacing="0.01"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ride together. Travel smarter."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginTop="27dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
