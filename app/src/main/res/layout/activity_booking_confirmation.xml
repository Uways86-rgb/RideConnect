<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎫 Confirm Booking"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please review the ride details before confirming."
            android:textSize="16sp"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="30dp"
            android:background="#EEEEEE">

            <TextView
                android:id="@+id/bookingDriverText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Driver:"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/bookingVehicleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vehicle:"
                android:textSize="17sp"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/bookingRouteText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Route:"
                android:textSize="17sp"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/bookingDateTimeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date / Time:"
                android:textSize="17sp"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/bookingSeatsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Available seats:"
                android:textSize="17sp"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/bookingPriceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fare:"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="15dp"/>


            <TextView
                android:id="@+id/passengerPickupHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Your Pickup Location"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/passengerPickupInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tap the map to select the exact location where the driver should pick you up."
                android:textSize="15sp" />

            <org.osmdroid.views.MapView
                android:id="@+id/passengerPickupMap"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/passengerPickupAddressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No pickup point selected yet."
                android:textSize="16sp"
                android:textStyle="bold" />


        </LinearLayout>

        <Button
            android:id="@+id/confirmBookingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ CONFIRM BOOKING"
            android:textSize="18sp"
            android:layout_marginTop="30dp"/>

        <Button
            android:id="@+id/cancelBookingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CANCEL"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>

</ScrollView>