<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Brand header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="@color/navy">

            <ImageView
                android:id="@+id/registerCarImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/rideconnect_splash"
                android:scaleType="fitXY"
                android:contentDescription="BMW car photograph"/>

            <!-- Header text overlay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal|bottom"
                android:background="#55041E42"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Account"
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Join the RideConnect community"
                    android:textSize="13sp"
                    android:textColor="#F5B82E"
                    android:layout_marginTop="6dp"/>

            </LinearLayout>

        </FrameLayout>

        <!-- Registration form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="20dp"
            android:layout_marginTop="18dp"
            android:elevation="3dp">

            <!-- Selected role -->
            <TextView
                android:id="@+id/selectedRoleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registering as: Passenger"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/teal"
                android:background="@color/screen_background"
                android:padding="14dp"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <!-- Personal information -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal Information"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/navy"
                android:layout_marginBottom="16dp"/>

            <!-- Full name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Enter your full name"
                android:inputType="textPersonName|textCapWords"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/teal"/>

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Enter your email address"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/teal"/>

            <!-- Phone -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile Phone Number"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/phoneInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Enter your phone number"
                android:inputType="phone"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/teal"/>

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="6dp"/>

            <!-- Password field with visibility toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@android:color/transparent">

                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Create a password"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="5dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:backgroundTint="@color/teal"/>

                <ImageButton
                    android:id="@+id/togglePasswordVisibility"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_visibility"
                    android:scaleType="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Show password"
                    android:padding="12dp"/>

            </LinearLayout>

            <!-- Driving Information -->
            <TextView
                android:id="@+id/drivingInformationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Driving Information"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/navy"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="15dp"
                android:visibility="gone"/>

            <!-- Date Registered -->
            <TextView
                android:id="@+id/registrationDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date Registered with RideConnect"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp"
                android:visibility="gone"/>

            <EditText
                android:id="@+id/registrationDateInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Select registration date"
                android:focusable="false"
                android:clickable="true"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/teal"
                android:visibility="gone"/>

            <!-- Years of Driving Experience -->
            <TextView
                android:id="@+id/drivingExperienceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Years of Driving Experience"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone"/>

            <EditText
                android:id="@+id/drivingExperienceInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Enter years of experience"
                android:inputType="number"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/teal"
                android:visibility="gone"/>

            <!-- Vehicle information -->
            <TextView
                android:id="@+id/vehicleInformationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vehicle Information"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/navy"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="15dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/vehicleCategoryLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vehicle Category"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone"/>

            <Spinner
                android:id="@+id/vehicleCategorySpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:spinnerMode="dropdown"/>

            <!-- Car registration -->
            <EditText
                android:id="@+id/carRegistrationInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Car Registration Number"
                android:inputType="textCapCharacters"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/teal"
                android:visibility="gone"
                android:layout_marginTop="10dp"/>

            <!-- Car make -->
            <EditText
                android:id="@+id/carMakeInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Car Make (e.g. Toyota)"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/teal"
                android:visibility="gone"
                android:layout_marginTop="10dp"/>

            <!-- Car model -->
            <EditText
                android:id="@+id/carModelInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Car Model (e.g. Corolla)"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/teal"
                android:visibility="gone"
                android:layout_marginTop="10dp"/>

            <!-- Car colour -->
            <EditText
                android:id="@+id/carColorInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Car Colour (e.g. White)"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/teal"
                android:visibility="gone"
                android:layout_marginTop="10dp"/>

            <!-- Driver Operating Areas -->
            <TextView
                android:id="@+id/driverLocationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Operating Areas"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/navy"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/operatingAreasDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Search for a town, village or neighbourhood. Select an entire locality or choose individual sublocalities."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp"
                android:visibility="gone"/>

            <!-- Selected operating areas -->
            <LinearLayout
                android:id="@+id/selectedOperatingAreasContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>

            <!-- Search results -->
            <LinearLayout
                android:id="@+id/operatingAreasContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"/>

            <!-- Selection summary -->
            <TextView
                android:id="@+id/operatingAreasSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No operating areas selected"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp"
                android:visibility="gone"/>

            <!-- Register button -->
            <Button
                android:id="@+id/registerButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="CREATE ACCOUNT"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:backgroundTint="@color/teal"
                android:layout_marginTop="28dp"
                android:elevation="3dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ride together. Travel smarter."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>
