<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp">

        <!-- TITLE -->


        <!-- BMW IMAGE HEADER -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginStart="-30dp"
            android:layout_marginEnd="-30dp"
            android:background="@color/navy">

            <ImageView
                android:id="@+id/postRideCarImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/rideconnect_splash"
                android:scaleType="fitXY"
                android:contentDescription="BMW car photograph"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal|bottom"
                android:background="#55041E42"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Post a Ride"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create a ride for passengers to book"
                    android:textSize="12sp"
                    android:textColor="#F5B82E"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>

        </FrameLayout>


        <!-- PICKUP -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pickup Location"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"/>

        <EditText
            android:id="@+id/pickupInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Moka"
            android:inputType="textCapWords"
            android:layout_marginTop="8dp"/>

        <!-- DESTINATION -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Destination"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/destinationInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Port Louis"
            android:inputType="textCapWords"
            android:layout_marginTop="8dp"/>

        <!-- CALCULATE ROUTE -->

        <Button
            android:id="@+id/calculateRouteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CALCULATE ROUTE"
            android:textSize="16sp"
            android:layout_marginTop="20dp"/>

        <!-- ROUTE STATUS -->

        <TextView
            android:id="@+id/routeStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your pickup and destination, then calculate your route."
            android:textSize="14sp"
            android:padding="10dp"
            android:layout_marginTop="8dp"/>

        <!-- MAP -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Route Map"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>

        <org.osmdroid.views.MapView
            android:id="@+id/postRideMap"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="10dp"/>

        <!-- EXACT LOCATION SELECTION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select the point you want to adjust"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Pickup or Destination below, then tap or long-press the exact position on the map."
            android:textSize="14sp"
            android:layout_marginTop="6dp"/>

        <RadioGroup
            android:id="@+id/locationSelectionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <RadioButton
                android:id="@+id/selectPickupRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Adjust Pickup Point"
                android:checked="true"
                android:padding="8dp"/>

            <RadioButton
                android:id="@+id/selectDestinationRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Adjust Destination Point"
                android:padding="8dp"/>

        </RadioGroup>

        <TextView
            android:id="@+id/pickupPointText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pickup point: Not selected"
            android:textSize="14sp"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            android:background="#F1F5F9"/>

        <TextView
            android:id="@+id/destinationPointText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Destination point: Not selected"
            android:textSize="14sp"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            android:background="#F1F5F9"/>

        <!-- AVAILABLE ROUTES -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available Routes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <RadioGroup
            android:id="@+id/routeOptionsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"/>

        <!-- SELECTED ROUTE SUMMARY -->

        <TextView
            android:id="@+id/routeSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your selected route details will appear here."
            android:textSize="15sp"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:background="#F1F5F9"/>

        <!-- DATE -->

        <TextView
            android:id="@+id/dateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date: Not selected"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp"/>

        <Button
            android:id="@+id/selectDateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 SELECT DATE"
            android:layout_marginTop="8dp"/>

        <!-- TIME -->

        <TextView
            android:id="@+id/timeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time: Not selected"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>

        <Button
            android:id="@+id/selectTimeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕐 SELECT TIME"
            android:layout_marginTop="8dp"/>

        <!-- AVAILABLE SEATS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available Seats"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/seatsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 3"
            android:inputType="number"
            android:layout_marginTop="8dp"/>

        <!-- PRICE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Price per Passenger (Rs)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/priceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 100"
            android:inputType="numberDecimal"
            android:layout_marginTop="8dp"/>

        <!-- POST RIDE -->

        <Button
            android:id="@+id/postRideButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚗 POST RIDE"
            android:textSize="18sp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/driverPostHomeNavItem"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏠\nHome"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/driverPostRideNavItem"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="➕\nPost Ride"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/teal"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/driverPostBookingsNavItem"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📋\nBookings"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/driverPostAccountNavItem"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👤\nAccount"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>