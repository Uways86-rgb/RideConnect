<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.RideConnect"
        parent="Theme.Material3.Light.NoActionBar">

        <item name="colorPrimary">@color/navy</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/teal</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorTertiary">@color/gold</item>
        <item name="colorOnTertiary">@color/navy</item>

        <item name="colorSurface">@color/card_white</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/card_white</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:windowBackground">@color/screen_background</item>

        <item name="android:colorAccent">@color/teal</item>

    </style>

